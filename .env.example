# NAVER API HUB 자격증명 (NAVER Cloud Platform 콘솔 > NAVER API HUB)
# 이 파일을 .env로 복사해 값을 채우세요. .env는 git에 올라가지 않습니다.
# 서버는 환경변수를 우선 쓰고, 비어 있는 키만 작업 폴더의 .env에서 채웁니다.
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=

# (선택) 도서 브랜드 분석 도구 설정
# NAVER_EXPORT_DIR=./exports
# NAVER_CACHE_DIR=
# NAVER_CACHE_TTL_HOURS=24
# NAVER_TOOLS_ALLOW=brand_compare_trend,brand_mentions,find_category

# (선택) 네이버 검색광고 API: 검색량 역산 도구(searchad_keyword_volume, estimate_search_volume)
# 검색광고 > 도구 > API 사용 관리에서 발급. 세 값을 모두 채우거나 모두 비워 두세요.
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_ACCESS_LICENSE=
NAVER_SEARCHAD_SECRET_KEY=
